+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { installHostDepartureGuard } from '../../src/host/departure.js';
+import { createInquirySession } from '../../src/product-room/inquiry-session.js';
+import { createDemoProjectRepository } from '../../src/product-room/project-repository.js';
+const deferred = () => { let resolve, reject; const promise = new Promise((a,b) => { resolve=a; reject=b; }); return {promise,resolve,reject}; };
+
+test('outer navigation leaves clean work immediately without inventing a dirty warning', async () => {
+  const win={}; const remove=installHostDepartureGuard({window:win,beforeLeave:()=>true});
+  assert.equal(win.annoraDemoHost.isDirty(),false); assert.equal(win.annoraDemoHost.isBusy(),false);
+  assert.equal(await win.annoraDemoHost.beforeLeave(),true); remove(); assert.equal(win.annoraDemoHost,undefined);
+});
+
+test('pending seller choice retains iframe and repeated outer clicks share one decision', async () => {
+  const win={}, decision=deferred(); let prompts=0, removed=false;
+  installHostDepartureGuard({window:win,isDirty:()=>true,beforeLeave:()=>{prompts++;return decision.promise;}});
+  const first=win.annoraDemoHost.beforeLeave(), second=win.annoraDemoHost.beforeLeave();
+  assert.equal(first,second); first.then(allowed=>{removed=allowed;}); await Promise.resolve();
+  assert.equal(prompts,1); assert.equal(removed,false); assert.equal(win.annoraDemoHost.isDirty(),true);
+  decision.resolve(false); assert.equal(await first,false); assert.equal(removed,false);
+});
+
+test('explicit discard permits removal, while failed save never grants departure', async () => {
+  const win={}; let mode='save';
+  installHostDepartureGuard({window:win,isDirty:()=>true,beforeLeave:()=>{if(mode==='save')throw new Error('Storage full');return true;}});
+  assert.equal(await win.annoraDemoHost.beforeLeave(),false);
+  assert.equal(win.annoraDemoHost.isDirty(),true);
+  mode='discard'; assert.equal(await win.annoraDemoHost.beforeLeave(),true);
+});
+
+test('save approval waits for persistence and exposes dirty separately from busy', async () => {
+  const win={}, save=deferred(); let stored=185, edited=999, dirty=true, busy=false;
+  installHostDepartureGuard({window:win,isDirty:()=>dirty,isBusy:()=>busy,beforeLeave:async()=>{busy=true;await save.promise;stored=edited;dirty=false;busy=false;return true;}});
+  const departure=win.annoraDemoHost.beforeLeave(); await Promise.resolve();
+  assert.equal(stored,185); assert.equal(win.annoraDemoHost.isBusy(),true); assert.equal(win.annoraDemoHost.isDirty(),true);
+  save.resolve(); assert.equal(await departure,true); assert.equal(stored,999); assert.equal(win.annoraDemoHost.isDirty(),false);
+});
+
+test('a retired frame or replaced guard cannot approve a later parent departure', async () => {
+  const win={}, decision=deferred();
+  const remove=installHostDepartureGuard({window:win,beforeLeave:()=>decision.promise});
+  const old=win.annoraDemoHost, pending=old.beforeLeave(); await Promise.resolve(); remove();
+  installHostDepartureGuard({window:win,beforeLeave:()=>false}); decision.resolve(true);
+  assert.equal(await pending,false); assert.equal(await old.beforeLeave(),false); assert.equal(await win.annoraDemoHost.beforeLeave(),false);
+});
+
+test('buyer host departure flushes a real unsaved inquiry before outer iframe removal', async () => {
+  const win={}, data=new Map();let id=0;
+  const repository=createDemoProjectRepository({storage:{getItem:k=>data.get(k)??null,setItem:(k,v)=>data.set(k,v)},locks:null,makeId:prefix=>`${prefix}-${++id}`});
+  const session=createInquirySession({repository,autosaveDelay:60000});
+  const context={productId:'kinetic-01',productTitle:'Crank-slider',modelId:'kinetic-01',modelRevision:'test-r1',part:{id:'rod',title:'Connecting rod'}};
+  await session.open({context});session.updateValues({application:'Unsaved packing-line discussion',quantity:'30'});
+  installHostDepartureGuard({window:win,isDirty:()=>session.hasUnsavedChanges(),beforeLeave:()=>session.beforeLeave()});
+  assert.equal(win.annoraDemoHost.isDirty(),true);assert.equal(await win.annoraDemoHost.beforeLeave(),true);
+  const saved=await repository.getDraft(context);assert.equal(saved.values.quantity,'30');assert.equal(saved.values.application,'Unsaved packing-line discussion');assert.equal(saved.context.part.id,'rod');
+  assert.equal(win.annoraDemoHost.isDirty(),false);session.dispose();
+});
diff --git a/src/product-room/viewer-retry.js b/src/product-room/viewer-retry.js
new file mode 100644
--- /dev/null
+++ b/src/product-room/viewer-retry.js
@@ -0,0 +1,16 @@
+/** Recover the route that was waiting for 3D, without advancing a review. */
+export function createRoomViewerRetry({ capture, isCurrent, hasInquiry, reload, resumeInquiry }) {
+  let pending = null;
+  return function retry() {
+    if (pending) return pending;
+    const snapshot = capture();
+    pending = Promise.resolve().then(reload).then(async () => {
+      // A timeout can occur before the inquiry host mounts. Loading the model
+      // alone cannot register its next action; reopen that same saved route.
+      // Existing editors and navigation during recovery remain authoritative.
+      if (snapshot.route.view === 'inquiry' && isCurrent(snapshot) && !hasInquiry())
+        await resumeInquiry(snapshot.route);
+    }).finally(() => { pending = null; });
+    return pending;
+  };
+}
