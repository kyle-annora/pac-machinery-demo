new file mode 100644
--- /dev/null
+++ b/src/shared/foreground-deadline.js
@@ -0,0 +1,63 @@
+/** Startup deadlines spend budget only while this document can make progress.
+ * Success/error delivery is never gated; callers still own cancellation/failure.
+ */
+export function createForegroundDeadlineScope({ document: doc = globalThis.document,
+  window: win = globalThis.window, now = () => globalThis.performance?.now?.() ?? Date.now() } = {}) {
+  let disposed = false, cached = false, frozen = false, printing = false;
+  const deadlines = new Set(), subscribers = new Set(), removers = [];
+  const eligible = () => !disposed && !doc?.hidden && !cached && !frozen && !printing;
+  let active = eligible();
+  function stop(record, spend = true) {
+    ++record.generation;
+    if (record.timer !== null) clearTimeout(record.timer);
+    record.timer = null;
+    if (spend && record.started !== null) record.remaining = Math.max(0, record.remaining - Math.max(0, now() - record.started));
+    record.started = null;
+  }
+  function arm(record) {
+    if (!active || disposed || !deadlines.has(record)) return;
+    const generation = ++record.generation;
+    record.started = now();
+    record.timer = setTimeout(() => {
+      if (!deadlines.has(record) || generation !== record.generation || !active || !eligible()) return;
+      record.timer = null; record.started = null; deadlines.delete(record);
+      record.callback();
+    }, record.remaining);
+  }
+  function sync() {
+    const next = eligible();
+    if (next === active) return;
+    active = next;
+    for (const record of deadlines) { if (active) arm(record); else stop(record); }
+    for (const subscriber of subscribers) subscriber(active);
+  }
+  function listen(target, name, callback) {
+    target?.addEventListener?.(name, callback);
+    removers.push(() => target?.removeEventListener?.(name, callback));
+  }
+  listen(doc, 'visibilitychange', sync);
+  listen(doc, 'freeze', () => { frozen = true; sync(); });
+  listen(doc, 'resume', () => { frozen = false; sync(); });
+  listen(win, 'pagehide', event => { if (!event.persisted) dispose(); else { cached = true; sync(); } });
+  listen(win, 'pageshow', () => { cached = false; sync(); });
+  listen(win, 'beforeprint', () => { printing = true; sync(); });
+  listen(win, 'afterprint', () => { printing = false; sync(); });
+  function dispose() {
+    if (disposed) return;
+    disposed = true; sync();
+    for (const record of deadlines) stop(record, false);
+    deadlines.clear(); subscribers.clear();
+    for (const remove of removers) remove();
+  }
+  return {
+    isActive: () => active && !disposed,
+    subscribe(callback) { subscribers.add(callback); return () => subscribers.delete(callback); },
+    deadline(callback, milliseconds) {
+      if (!Number.isFinite(milliseconds) || milliseconds < 0) throw new TypeError('A deadline needs a non-negative finite budget.');
+      const record = { callback, remaining: milliseconds, timer: null, started: null, generation: 0 };
+      if (!disposed) { deadlines.add(record); arm(record); }
+      return () => { stop(record, false); deadlines.delete(record); };
+    },
+    dispose,
+  };
+}
