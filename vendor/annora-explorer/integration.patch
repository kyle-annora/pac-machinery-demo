@@ -0,0 +1,27 @@
+/** Same-origin shell lifecycle only; never exposes renderer or draft internals. */
+export function installHostDepartureGuard({ window: win = globalThis.window, beforeLeave,
+  isDirty = () => false, isBusy = () => false } = {}) {
+  if (!win || typeof beforeLeave !== 'function') throw new TypeError('A host departure guard needs a window and beforeLeave callback.');
+  const previous = win.annoraDemoHost;
+  let disposed = false, pending = null;
+  const api = Object.freeze({
+    version: 1,
+    isDirty: () => !disposed && Boolean(isDirty()),
+    isBusy: () => !disposed && Boolean(isBusy()),
+    beforeLeave() {
+      if (disposed || win.annoraDemoHost !== api) return Promise.resolve(false);
+      if (!pending) pending = Promise.resolve().then(beforeLeave)
+        .then(allowed => !disposed && win.annoraDemoHost === api && allowed === true, () => false)
+        .finally(() => { pending = null; });
+      return pending;
+    },
+  });
+  win.annoraDemoHost = api;
+  return () => {
+    disposed = true;
+    if (win.annoraDemoHost === api) {
+      if (previous === undefined) delete win.annoraDemoHost;
+      else win.annoraDemoHost = previous;
+    }
+  };
+}
